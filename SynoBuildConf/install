#!/bin/bash
set -e

PKG_DIR="/tmp/_AV_ImgData_pkg"
rm -rf "$PKG_DIR"
mkdir -p "$PKG_DIR"
INSTALL_SUCCEEDED=0

if [ "${NOSTRIP:-}" = "NOSTRIP" ]; then
	export AV_IMGDATA_NATIVE_STRIP="${AV_IMGDATA_NATIVE_STRIP:-0}"
fi

cleanup_native_build_artifacts() {
	if [ "$INSTALL_SUCCEEDED" != "1" ]; then
		echo "Preserving native build artifacts after failed install for diagnostics."
		return
	fi
	local native_root
	native_root="$(native_build_root)"
	rm -rf \
		"$native_root/deps/source-cache" \
		"$native_root/face_processor-build" \
		"$native_root/face_processor-install" \
		"$native_root/libde265-build" \
		"$native_root/libde265-source" \
		"$native_root/libheif-build" \
		"$native_root/libheif-source" \
		"$native_root/libvips-build" \
		"$native_root/libvips-source" \
		"$native_root/vips-image-processor-build"
}
trap cleanup_native_build_artifacts EXIT

# load helper functions
source /pkgscripts/include/pkg_util.sh

native_platform_candidates() {
	local platform="${SYNO_PLATFORM:-local}"
	local lower_platform
	lower_platform="$(printf '%s' "$platform" | tr '[:upper:]' '[:lower:]')"
	printf '%s\n' "$platform"
	if [ "$lower_platform" != "$platform" ]; then
		printf '%s\n' "$lower_platform"
	fi
	printf '%s\n' "local"
}

native_build_root() {
	local candidate
	while IFS= read -r candidate; do
		if [ -d "build/native/$candidate" ]; then
			printf '%s\n' "build/native/$candidate"
			return 0
		fi
	done <<EOF
$(native_platform_candidates)
EOF
	printf '%s\n' "build/native/${SYNO_PLATFORM:-local}"
}

native_install_root() {
	local install_name="$1"
	local candidate
	while IFS= read -r candidate; do
		if [ -d "build/native/$candidate/$install_name/usr/local/AV_ImgData" ]; then
			printf '%s\n' "build/native/$candidate/$install_name/usr/local/AV_ImgData"
			return 0
		fi
	done <<EOF
$(native_platform_candidates)
EOF
	printf '%s\n' "$(native_build_root)/$install_name/usr/local/AV_ImgData"
}

ensure_native_face_processor() {
	local install_root
	install_root="$(native_install_root face_processor-install)"
	if [ "${NOSTRIP:-}" != "NOSTRIP" ] && [ -x "$install_root/bin/av-imgdata-face-processor" ]; then
		return 0
	fi
	if [ "${NOSTRIP:-}" = "NOSTRIP" ]; then
		echo "Debug package requested; rebuilding native face processor without stripping."
	else
		echo "Native face processor missing; building before package staging."
	fi
	if ! ./tools/build-native-face-processor.sh; then
		echo "ERROR: native ONNXRuntime face processor build failed."
		return 1
	fi
	if ! ./tools/smoke-native-face-processor.sh; then
		echo "ERROR: native ONNXRuntime face processor smoke checks failed."
		return 1
	fi
	if ! ./tools/functional-native-face-processor.sh; then
		echo "ERROR: native ONNXRuntime face processor functional checks failed."
		return 1
	fi
}

ensure_vips_image_processor() {
	local install_root
	local fingerprint_file
	local expected_fingerprint
	local current_fingerprint
	if [ "${AV_IMGDATA_WITH_VIPS:-1}" != "1" ]; then
		return 0
	fi
	install_root="$(native_install_root vips-image-processor-install)"
	fingerprint_file="$install_root/share/av-imgdata-image-processor.build-fingerprint"
	if [ -x "$install_root/bin/av-imgdata-image-processor" ]; then
		expected_fingerprint="$(./tools/build-native-image-processor-vips.sh --print-fingerprint 2>/dev/null || true)"
		current_fingerprint="$(cat "$fingerprint_file" 2>/dev/null || true)"
		if [ -n "$expected_fingerprint" ] && [ "$current_fingerprint" = "$expected_fingerprint" ]; then
			return 0
		fi
		echo "Existing libvips image processor is stale or unversioned; rebuilding before package staging."
	else
		echo "Optional libvips image processor missing; building before package staging."
	fi
	if ! ./tools/build-native-image-processor-vips.sh; then
		echo "ERROR: native libvips image processor build failed."
		return 1
	fi
}

package_external_worker_archives() {
	local package_tgz_dir="$1"
	local target
	local source_dir
	local bundle_name
	local archive_path
	local archive_type
	local required_targets="${AV_IMGDATA_PACKAGE_WORKER_TARGETS:-linux-x86_64 docker-linux-x86_64 windows-x86_64}"

	if [ "${AV_IMGDATA_PACKAGE_EXTERNAL_WORKERS:-1}" = "0" ]; then
		echo "Skipping external worker archive packaging because AV_IMGDATA_PACKAGE_EXTERNAL_WORKERS=0."
		return 0
	fi

	mkdir -p "$package_tgz_dir/workers"
	for target in $required_targets; do
		bundle_name="av-imgdata-worker-${target}"
		source_dir="dist/${bundle_name}"
		if [ "$target" = "windows-x86_64" ] && [ -d "${source_dir}.package" ]; then
			source_dir="${source_dir}.package"
		fi
		archive_type="tar.gz"
		archive_path="$package_tgz_dir/workers/${bundle_name}.tar.gz"
		if [ ! -d "$source_dir" ]; then
			echo "ERROR: external worker bundle missing: $source_dir"
			echo "Run tools/build-package.sh, or build the worker with: tools/build-worker.sh --target $target --clean"
			exit 1
		fi
		if [ "$target" = "windows-x86_64" ]; then
			if [ ! -f "$source_dir/bin/av-imgdata-worker.exe" ]; then
				echo "ERROR: Windows external worker binary missing: $source_dir/bin/av-imgdata-worker.exe"
				exit 1
			fi
			if [ ! -f "$source_dir/bin/av-imgdata-face-processor.exe" ]; then
				echo "ERROR: Windows external worker face processor missing: $source_dir/bin/av-imgdata-face-processor.exe"
				exit 1
			fi
			if [ ! -f "$source_dir/SHA256SUMS.txt" ]; then
				echo "ERROR: Windows external worker checksum manifest missing: $source_dir/SHA256SUMS.txt"
				echo "Run tools/build-worker.sh --target $target --clean before packaging."
				exit 1
			fi
			if ! command -v zip >/dev/null 2>&1; then
				echo "ERROR: zip command missing; required to package Windows external worker archive."
				exit 1
			fi
			archive_type="zip"
			archive_path="$package_tgz_dir/workers/${bundle_name}.zip"
		else
			if [ ! -x "$source_dir/bin/av-imgdata-worker" ]; then
				echo "ERROR: external worker binary missing or not executable: $source_dir/bin/av-imgdata-worker"
				exit 1
			fi
			if [ ! -x "$source_dir/bin/av-imgdata-face-processor" ]; then
				echo "ERROR: external worker face processor missing or not executable: $source_dir/bin/av-imgdata-face-processor"
				exit 1
			fi
		fi
		echo "Packaging external worker archive: $archive_path"
		if [ "$archive_type" = "zip" ]; then
			(cd "$source_dir" && zip -qr "$archive_path" .)
		else
			tar -C "$source_dir" -czf "$archive_path" .
		fi
	done
}

assert_no_duplicate_package_sonames() {
	local package_tgz_dir="$1"
	local lib_dir="$package_tgz_dir/lib"
	local tmp_file
	local duplicates
	local source
	local soname

	[ -d "$lib_dir" ] || return 0
	if [ -n "$(find "$lib_dir" -maxdepth 1 -type f -name '*.so*' -print -quit 2>/dev/null)" ] && ! command -v readelf >/dev/null 2>&1; then
		echo "ERROR: readelf is required to verify packaged runtime library SONAMEs." >&2
		return 1
	fi
	tmp_file="$(mktemp /tmp/av-imgdata-package-sonames.XXXXXX)"
	find "$lib_dir" -maxdepth 1 -type f -name '*.so*' -print0 2>/dev/null | while IFS= read -r -d '' source; do
		soname="$(readelf -d "$source" 2>/dev/null | awk '/SONAME/ {gsub(/\[|\]/, "", $5); print $5; exit}')"
		[ -n "$soname" ] || continue
		printf '%s\t%s\n' "$soname" "$(basename "$source")"
	done > "$tmp_file"
	duplicates="$(cut -f1 "$tmp_file" | sort | uniq -d | tr '\n' ' ')"
	if [ -n "$duplicates" ]; then
		echo "ERROR: duplicate package runtime library SONAMEs in $lib_dir: $duplicates" >&2
		sort "$tmp_file" >&2
		rm -f "$tmp_file"
		return 1
	fi
	rm -f "$tmp_file"
}

copy_runtime_library_family() {
	local source_dir="$1"
	local target_dir="$2"
	shift 2
	local tmp_file
	local pattern
	local source
	local real_source
	local real_name
	local source_name
	local soname

	[ -d "$source_dir" ] || return 0
	mkdir -p "$target_dir"
	tmp_file="$(mktemp /tmp/av-imgdata-runtime-sonames.XXXXXX)"
	find "$target_dir" -maxdepth 1 -type f -name '*.so*' -print0 2>/dev/null | while IFS= read -r -d '' source; do
		soname="$(readelf -d "$source" 2>/dev/null | awk '/SONAME/ {gsub(/\[|\]/, "", $5); print $5; exit}')"
		[ -n "$soname" ] || continue
		printf '%s\n' "$soname"
	done > "$tmp_file"

	for pattern in "$@"; do
		find "$source_dir" -maxdepth 1 \( -type f -o -type l \) -name "$pattern" -print0 2>/dev/null | while IFS= read -r -d '' source; do
			real_source="$(readlink -f "$source" 2>/dev/null || printf '%s' "$source")"
			[ -f "$real_source" ] || continue
			soname="$(readelf -d "$real_source" 2>/dev/null | awk '/SONAME/ {gsub(/\[|\]/, "", $5); print $5; exit}')"
			[ -n "$soname" ] || continue
			if grep -Fxq "$soname" "$tmp_file"; then
				continue
			fi
			real_name="$(basename "$real_source")"
			source_name="$(basename "$source")"
			cp -av --no-preserve=ownership "$real_source" "$target_dir/$real_name"
			if [ "$soname" != "$real_name" ]; then
				ln -sfn "$real_name" "$target_dir/$soname"
			fi
			if [ "$source_name" != "$real_name" ] && [ "$source_name" != "$soname" ]; then
				ln -sfn "$soname" "$target_dir/$source_name"
			fi
			printf '%s\n' "$soname" >> "$tmp_file"
		done
	done
	rm -f "$tmp_file"
}

create_install() {
	local package_tgz_dir=/tmp/_install

	# clear destination directory
	rm -rf $package_tgz_dir && mkdir -p $package_tgz_dir
	make clean_python_artifacts

	# install needed file into PKG_DIR on NAS
	cp -av --no-preserve=ownership src $package_tgz_dir
	cp -av --no-preserve=ownership app $package_tgz_dir
	cp -av --no-preserve=ownership conf $package_tgz_dir
	mkdir -p "$package_tgz_dir/tools"
	cp -av --no-preserve=ownership tools/worker-api-store.py "$package_tgz_dir/tools/"
	find "$package_tgz_dir/app" "$package_tgz_dir/src" -type d -name '__pycache__' -prune -exec rm -rf {} +
	find "$package_tgz_dir/app" "$package_tgz_dir/src" -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete
	make install DESTDIR="$package_tgz_dir" INSTALLDIR="$package_tgz_dir" || return 1
	ensure_native_face_processor || return 1
	NATIVE_INSTALL="$(native_install_root face_processor-install)"
	if [ ! -x "$NATIVE_INSTALL/bin/av-imgdata-face-processor" ]; then
		echo "ERROR: native face processor missing: $NATIVE_INSTALL/bin/av-imgdata-face-processor"
		echo "The native C++ face processor is required for this branch."
		return 1
	fi
	if ! strings "$NATIVE_INSTALL/bin/av-imgdata-face-processor" | grep -q 'onnxruntime-native'; then
		echo "ERROR: native face processor does not report the onnxruntime-native backend."
		return 1
	fi
	if [ ! -e "$NATIVE_INSTALL/lib/libonnxruntime.so" ] && [ -z "$(find "$NATIVE_INSTALL/lib" -maxdepth 1 -name 'libonnxruntime.so*' -print -quit 2>/dev/null)" ]; then
		echo "ERROR: native face processor libraries missing: libonnxruntime.so*"
		return 1
	fi
	mkdir -p "$package_tgz_dir/bin"
	cp -av --no-preserve=ownership "$NATIVE_INSTALL/bin/av-imgdata-face-processor" "$package_tgz_dir/bin/"
	if [ -d "$NATIVE_INSTALL/lib" ]; then
		copy_runtime_library_family "$NATIVE_INSTALL/lib" "$package_tgz_dir/lib" 'libonnxruntime.so*' 'libjpeg.so*'
	fi
	if [ -d "$NATIVE_INSTALL/share/licenses" ]; then
		mkdir -p "$package_tgz_dir/share"
		cp -av --no-preserve=ownership "$NATIVE_INSTALL/share/licenses" "$package_tgz_dir/share/"
	fi
	ensure_vips_image_processor || return 1
	VIPS_INSTALL="$(native_install_root vips-image-processor-install)"
	if [ "${AV_IMGDATA_WITH_VIPS:-1}" = "1" ]; then
		if [ ! -x "$VIPS_INSTALL/bin/av-imgdata-image-processor" ]; then
			echo "ERROR: optional libvips image processor missing: $VIPS_INSTALL/bin/av-imgdata-image-processor"
			return 1
		fi
		mkdir -p "$package_tgz_dir/bin"
		cp -av --no-preserve=ownership "$VIPS_INSTALL/bin/av-imgdata-image-processor" "$package_tgz_dir/bin/"
		if [ ! -e "$VIPS_INSTALL/lib/libvips.so" ] && [ -z "$(find "$VIPS_INSTALL/lib" -maxdepth 1 -name 'libvips.so*' -print -quit 2>/dev/null)" ]; then
			echo "ERROR: optional libvips image processor libraries missing: libvips.so*"
			return 1
		fi
		if [ -d "$VIPS_INSTALL/lib" ]; then
			copy_runtime_library_family "$VIPS_INSTALL/lib" "$package_tgz_dir/lib" '*.so*'
		fi
		if [ -d "$VIPS_INSTALL/share/licenses" ]; then
			mkdir -p "$package_tgz_dir/share"
			cp -av --no-preserve=ownership "$VIPS_INSTALL/share/licenses" "$package_tgz_dir/share/"
		fi
	fi
	python3 tools/verify-third-party-licenses.py --root "$package_tgz_dir" --write || return 1
	assert_no_duplicate_package_sonames "$package_tgz_dir" || return 1
	package_external_worker_archives "$package_tgz_dir"
	# Fail fast if UI entrypoint didn't get packaged
	if [ ! -f "$package_tgz_dir/ui/index.cgi" ]; then
		echo "ERROR: ui/index.cgi missing in package staging dir."
		echo "Check ui/Makefile install target and build artifacts."
		return 1
	fi
	make packageinstall DESTDIR="$package_tgz_dir" PKG_DIR="$PKG_DIR" || return 1

	# create package.tgz $1: source_dir $2: dest_dir
	pkg_make_package $package_tgz_dir "${PKG_DIR}"
}

create_spk() {
	# copy scripts, conf and optional files
	cp -av --no-preserve=ownership scripts $PKG_DIR/scripts
	cp -av --no-preserve=ownership conf $PKG_DIR
	cp -av --no-preserve=ownership LICENSE $PKG_DIR/LICENSE
	cp -av --no-preserve=ownership ui/PACKAGE_ICON.png  $PKG_DIR/PACKAGE_ICON.PNG
	cp -av --no-preserve=ownership ui/PACKAGE_ICON_256.png $PKG_DIR/PACKAGE_ICON_256.PNG

	./INFO.sh > INFO
	cp INFO $PKG_DIR/INFO

	# spk name functions: pkg_get_spk_name pkg_get_spk_unified_name pkg_get_spk_family_name
	mkdir -p /image/packages
	rm -f "/image/packages/$(pkg_get_spk_family_name)"
	pkg_make_spk ${PKG_DIR} "/image/packages" $(pkg_get_spk_family_name)
}

main() {
	./INFO.sh > INFO
	create_install
	create_spk
	INSTALL_SUCCEEDED=1
}

main "$@"
exit $?
